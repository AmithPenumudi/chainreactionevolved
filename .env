# Supabase connection for the game client.
#
# These two values are PUBLIC by design: Vite inlines them into the bundle at build time, so
# they ship inside the Android APK and the web deploy. Row-level security is what protects the
# data — see supabase/migrations/0001_player_data.sql, where nothing is granted to `anon`.
#
# The service_role key is NOT here and must never be: it bypasses RLS. It belongs in
# .env.local (gitignored), read only by scripts/dashboard.mjs on your own machine.
VITE_SUPABASE_URL=https://daysfmlkumclifaulgyi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ZNHzAU19R8OBWp3OMIULAg_M8wyZ6Fk
